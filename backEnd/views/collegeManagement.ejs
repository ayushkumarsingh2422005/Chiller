<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>College Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            padding-top: 2rem;
        }
        .card {
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            margin-bottom: 1.5rem;
        }
        .login-container {
            max-width: 400px;
            margin: auto;
        }
        .colleges-container {
            max-width: 1200px;
            margin: auto;
        }
        .college-actions {
            display: flex;
            gap: 0.5rem;
        }
        .btn-icon {
            padding: 0.375rem 0.75rem;
        }
        .filters {
            margin-bottom: 1.5rem;
        }
        .table-responsive {
            background-color: white;
            border-radius: 0.5rem;
        }
        .add-college-form {
            display: none;
        }
        .edit-mode {
            background-color: #fff3cd;
        }
    </style>
</head>
<body>
    <!-- Login Form -->
    <div class="login-container" id="loginForm">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title text-center mb-4">College Management Login</h3>
                <form onsubmit="handleLogin(event)">
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" class="form-control" id="password" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Login</button>
                </form>
            </div>
        </div>
    </div>

    <!-- College Management Interface -->
    <div class="colleges-container" id="collegeManagement" style="display: none;">
        <h2 class="text-center mb-4">College Management System</h2>
        
        <!-- Add College Button -->
        <div class="d-flex justify-content-end mb-3">
            <button class="btn btn-primary" onclick="toggleAddForm()">
                <i class="fas fa-plus"></i> Add New College
            </button>
        </div>

        <!-- Add College Form -->
        <div class="card add-college-form" id="addCollegeForm">
            <div class="card-body">
                <h4 class="card-title">Add New College</h4>
                <form onsubmit="handleAddCollege(event)">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control" name="name" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Location</label>
                            <input type="text" class="form-control" name="location" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Type</label>
                            <select class="form-select" name="type" required>
                                <option value="IIT">IIT</option>
                                <option value="NIT">NIT</option>
                                <option value="IIIT">IIIT</option>
                                <option value="GFTI">GFTI</option>
                                <option value="OTHER">OTHER</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Established Year</label>
                            <input type="number" class="form-control" name="established" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Website</label>
                            <input type="url" class="form-control" name="website" required>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary" onclick="toggleAddForm()">Cancel</button>
                        <button type="submit" class="btn btn-primary">Add College</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Filters -->
        <div class="card filters">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <input type="text" class="form-control" placeholder="Search colleges..." 
                               oninput="handleSearch(this.value)">
                    </div>
                    <div class="col-md-4 mb-2">
                        <select class="form-select" onchange="handleTypeFilter(this.value)">
                            <option value="">All Types</option>
                            <option value="IIT">IIT</option>
                            <option value="NIT">NIT</option>
                            <option value="IIIT">IIIT</option>
                            <option value="GFTI">GFTI</option>
                            <option value="OTHER">OTHER</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Colleges Table -->
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Established</th>
                        <th>Website</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="collegesTableBody">
                    <!-- Colleges will be loaded here -->
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let isAuthenticated = false;
        const ADMIN_PASSWORD = '<%= adminPassword %>';

        // Authentication
        function handleLogin(event) {
            event.preventDefault();
            const password = document.getElementById('password').value;
            
            if (password === ADMIN_PASSWORD) {
                isAuthenticated = true;
                document.getElementById('loginForm').style.display = 'none';
                document.getElementById('collegeManagement').style.display = 'block';
                loadColleges();
            } else {
                alert('Invalid password');
            }
        }

        // Toggle Add College Form
        function toggleAddForm() {
            const form = document.getElementById('addCollegeForm');
            form.style.display = form.style.display === 'none' ? 'block' : 'none';
        }

        // Load Colleges
        async function loadColleges() {
            try {
                const response = await fetch('/api/colleges/all');
                const data = await response.json();
                displayColleges(data.colleges);
            } catch (error) {
                console.error('Error loading colleges:', error);
            }
        }

        // Display Colleges
        function displayColleges(colleges) {
            const tbody = document.getElementById('collegesTableBody');
            tbody.innerHTML = colleges.map(college => `
                <tr id="college-${college._id}">
                    <td>${college.name}</td>
                    <td>${college.location}</td>
                    <td>${college.type}</td>
                    <td>${college.established}</td>
                    <td><a href="${college.website}" target="_blank">${college.website}</a></td>
                    <td class="college-actions">
                        <button class="btn btn-sm btn-warning btn-icon" onclick="editCollege('${college._id}')">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn btn-sm btn-danger btn-icon" onclick="deleteCollege('${college._id}')">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        // Add College
        async function handleAddCollege(event) {
            event.preventDefault();
            const formData = new FormData(event.target);
            const collegeData = Object.fromEntries(formData.entries());

            try {
                const response = await fetch('/api/colleges/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ colleges: [collegeData] })
                });

                if (response.ok) {
                    alert('College added successfully');
                    toggleAddForm();
                    loadColleges();
                    event.target.reset();
                } else {
                    alert('Error adding college');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error adding college');
            }
        }

        // Delete College
        async function deleteCollege(id) {
            if (!confirm('Are you sure you want to delete this college?')) return;

            try {
                const response = await fetch(`/api/colleges/${id}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    document.getElementById(`college-${id}`).remove();
                    alert('College deleted successfully');
                } else {
                    alert('Error deleting college');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error deleting college');
            }
        }

        // Update the existing search and filter functions
        async function handleSearch(value) {
            try {
                const typeFilter = document.querySelector('select.form-select').value;
                const response = await fetch(`/api/colleges/all?search=${value}${typeFilter ? `&type=${typeFilter}` : ''}`);
                const data = await response.json();
                displayColleges(data.colleges);
            } catch (error) {
                console.error('Error searching colleges:', error);
            }
        }

        async function handleTypeFilter(value) {
            try {
                const searchText = document.querySelector('input[placeholder="Search colleges..."]').value;
                const response = await fetch(`/api/colleges/all?type=${value}${searchText ? `&search=${searchText}` : ''}`);
                const data = await response.json();
                displayColleges(data.colleges);
            } catch (error) {
                console.error('Error filtering colleges:', error);
            }
        }

        // Add edit functionality
        function editCollege(id) {
            const row = document.getElementById(`college-${id}`);
            const cells = row.getElementsByTagName('td');
            
            // Convert row to editable form
            cells[0].innerHTML = `<input type="text" class="form-control" value="${cells[0].textContent}">`;
            cells[1].innerHTML = `<input type="text" class="form-control" value="${cells[1].textContent}">`;
            cells[2].innerHTML = `
                <select class="form-select">
                    <option value="IIT" ${cells[2].textContent === 'IIT' ? 'selected' : ''}>IIT</option>
                    <option value="NIT" ${cells[2].textContent === 'NIT' ? 'selected' : ''}>NIT</option>
                    <option value="IIIT" ${cells[2].textContent === 'IIIT' ? 'selected' : ''}>IIIT</option>
                    <option value="GFTI" ${cells[2].textContent === 'GFTI' ? 'selected' : ''}>GFTI</option>
                    <option value="OTHER" ${cells[2].textContent === 'OTHER' ? 'selected' : ''}>OTHER</option>
                </select>
            `;
            cells[3].innerHTML = `<input type="number" class="form-control" value="${cells[3].textContent}">`;
            cells[4].innerHTML = `<input type="url" class="form-control" value="${cells[4].querySelector('a').href}">`;
            
            // Change action buttons
            cells[5].innerHTML = `
                <button class="btn btn-sm btn-success btn-icon" onclick="saveEdit('${id}')">
                    <i class="fas fa-save"></i>
                </button>
                <button class="btn btn-sm btn-secondary btn-icon" onclick="cancelEdit('${id}')">
                    <i class="fas fa-times"></i>
                </button>
            `;
            
            row.classList.add('edit-mode');
        }

        async function saveEdit(id) {
            const row = document.getElementById(`college-${id}`);
            const inputs = row.querySelectorAll('input, select');
            
            const updatedData = {
                name: inputs[0].value,
                location: inputs[1].value,
                type: inputs[2].value,
                established: parseInt(inputs[3].value),
                website: inputs[4].value
            };

            try {
                const response = await fetch(`/api/colleges/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(updatedData)
                });

                if (response.ok) {
                    loadColleges(); // Reload the table
                    alert('College updated successfully');
                } else {
                    alert('Error updating college');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error updating college');
            }
        }

        function cancelEdit(id) {
            loadColleges(); // Reload the table to reset the row
        }
    </script>
</body>
</html> 